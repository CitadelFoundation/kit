---
import type { DocsTreeSection } from "../lib/publishing";

interface Props {
  readonly sections: readonly DocsTreeSection[];
  readonly currentSlug?: string;
}

const { sections, currentSlug } = Astro.props as Props;
---

<aside class="docs-sidebar">
  <p class="eyebrow">Documentation</p>
  {sections.length === 0 ? (
    <p class="lede">No documentation pages have been added yet.</p>
  ) : (
    sections.map((section) => (
      <section class="stack-gap">
        <h3>{section.title}</h3>
        <ul class="docs-link-list">
          {section.pages.map((page) => (
            <li>
              <a
                href={`/docs/${page.slug}/`}
                aria-current={page.slug === currentSlug ? "page" : undefined}
              >
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</aside>
