---
import "../styles/global.css";
import type {
  NavigationDocument,
  SiteSettingsDocument
} from "@citadelfoundation/kit-publishing/types";

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  siteSettings: SiteSettingsDocument;
  navigation: NavigationDocument;
}

const {
  pageTitle,
  pageDescription,
  siteSettings,
  navigation
} = Astro.props as Props;

const title = pageTitle ? `${pageTitle} | ${siteSettings.title}` : siteSettings.title;
const description = pageDescription ?? siteSettings.description;
---

<!doctype html>
<html lang={siteSettings.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container shell header-shell">
        <a class="brand" href="/">{siteSettings.title}</a>
        <nav aria-label="Primary">
          <ul class="nav-list">
            {navigation.mainLinks.map((item) => (
              <li>
                <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container shell footer-shell">
        <p>{siteSettings.footerNotice}</p>
        <ul class="footer-links">
          {navigation.footerLinks.map((item) => (
            <li>
              <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>
  </body>
</html>
