{
  "name": "@citadelfoundation/kit-publishing",
  "version": "0.1.1",
  "description": "Git-native local-first publishing toolkit for Astro sites and local studio workflows",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js",
      "default": "./dist/content/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js",
      "default": "./dist/studio/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "default": "./dist/astro/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.map",
    "!dist/**/tsconfig*.json",
    "!dist/**/*.tsbuildinfo",
    "!dist/package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build tsconfig.build.json --force && node ../../scripts/copy_package_assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "bun test src/content/file_content_repository.test.ts src/server/app.test.ts src/studio/editor_adapter.test.ts src/studio/components/publishing_studio.test.ts src/studio/host/model.test.ts src/workspace.test.ts",
    "export:standalone": "bun run scripts/export_standalone.ts",
    "studio:dev": "bun run src/studio/host/cli.ts",
    "storybook": "storybook dev -p 6106 --config-dir storybook/.storybook",
    "build-storybook": "storybook build --config-dir storybook/.storybook",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish_guard.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.4.2",
    "@tiptap/markdown": "^3.4.2",
    "@tiptap/starter-kit": "^3.4.2",
    "elysia": "^1.4.27",
    "markdown-it": "^14.1.0",
    "trix": "^2.1.15",
    "turndown": "^7.2.1",
    "yaml": "^2.6.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-themes": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/web-components-vite": "^10.3.3",
    "@types/bun": "^1.3.8",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.5",
    "lit": "^3.3.2",
    "storybook": "^10.3.3",
    "typescript": "^5.9.3"
  },
  "sideEffects": [
    "./dist/studio/components/*.js",
    "./dist/studio/host/client.js"
  ]
}
